<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.cpardi.markdowncodereview</id>
    <name>Markdown Code Review</name>
    <vendor url="https://github.com/CPardi">CPardi</vendor>
    <depends>com.intellij.modules.platform</depends>
    <resource-bundle>messages.ReviewBundle</resource-bundle>
    <extensions defaultExtensionNs="com.intellij">
        <!-- Application-level service for settings -->
        <applicationService serviceImplementation="com.github.cpardi.markdowncodereview.settings.ReviewSettings"/>

        <!-- Project-level service -->
        <projectService serviceImplementation="com.github.cpardi.markdowncodereview.services.ReviewService"/>

        <!-- Application-level settings configurable -->
        <applicationConfigurable parentId="tools"
                                 instance="com.github.cpardi.markdowncodereview.settings.ReviewSettingsConfigurable"
                                 id="com.github.cpardi.markdowncodereview.settings.ReviewSettingsConfigurable"
                                 key="settings.displayName"
                                 bundle="messages.ReviewBundle"/>

        <!-- Tool window -->
        <toolWindow id="Review Output"
                    factoryClass="com.github.cpardi.markdowncodereview.toolWindow.ReviewToolWindowFactory"
                    anchor="right"
                    icon="AllIcons.Toolwindows.ToolWindowInspection"/>

        <!-- Startup activity -->
        <postStartupActivity implementation="com.github.cpardi.markdowncodereview.startup.ReviewStartupActivity"/>

        <!-- Gutter icon line marker provider -->
        <codeInsight.lineMarkerProvider implementationClass="com.github.cpardi.markdowncodereview.markers.CommentLineMarkerProvider"
                language=""/>
    </extensions>

    <actions>
        <group id="ReviewMarkdownGenerator.ReviewGroup" text="Review" popup="true" icon="AllIcons.Toolwindows.ToolWindowInspection">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>

            <action id="ReviewMarkdownGenerator.AddCommentContextMenu"
                    class="com.github.cpardi.markdowncodereview.actions.AddCommentContextMenuAction"
                    text="Add Comment">
              <keyboard-shortcut keymap="$default" first-keystroke="alt ctrl K" second-keystroke="J"/>
              <keyboard-shortcut keymap="Mac OS X" first-keystroke="alt meta K" second-keystroke="J"/>
              <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="alt meta K" second-keystroke="J"/>
            </action>

            <action id="ReviewMarkdownGenerator.AddOrEditComment"
                    class="com.github.cpardi.markdowncodereview.actions.AddOrEditCommentAction"
                    text="Add or Edit Comment">
                <keyboard-shortcut keymap="$default" first-keystroke="alt ctrl K" second-keystroke="K"/>
                <keyboard-shortcut keymap="Mac OS X" first-keystroke="alt meta K" second-keystroke="K"/>
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="alt meta K" second-keystroke="K"/>
            </action>

            <action id="ReviewMarkdownGenerator.AddPageComment"
                    class="com.github.cpardi.markdowncodereview.actions.AddPageCommentAction"
                    text="Add Page Comment">
                <keyboard-shortcut keymap="$default" first-keystroke="alt ctrl K" second-keystroke="L"/>
                <keyboard-shortcut keymap="Mac OS X" first-keystroke="alt meta K" second-keystroke="L"/>
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="alt meta K" second-keystroke="L"/>
            </action>

            <separator/>
        </group>
    </actions>
</idea-plugin>
